{% extends "fullscreen.html.j2" %}
{% import "bootstrap/wtf.html" as wtf %}

{% block title %}TOTP Setup{% endblock %}

{% block styles %}
    {{ super() }}
    <style>
        .totp-setup-qr {
            display: block;
            margin: 0 auto;
            float: none;
        }
        .totp-setup-secret, .totp-setup-backup {
            font-family: monospace;
            font-size: 1.15em;
            text-align: center;
        }
        .totp-setup-backup {
            width: 100%;
        }
    </style>
{% endblock %}

{% block w_content %}
    <h2>Set Up Authenticator App</h2>
    <p>Set up your authenticator app by scanning this QR code</p>
    {{ totp_qr |safe }}

    <h3>Alternate Method</h3>
    <p>If you cannot scan the code, you may enter this secret key directly:</p>
    <p class="totp-setup-secret">{{ user.new_totp_secret }}</p>

    <h2>Save Backup Codes</h2>
    <p>Save the following backup codes in a safe place.  <em>They will not be shown again!</em></p>
    <table class="totp-setup-backup">
        {% for i in range(((user.new_totp_backup_codes |length) / 2) |ceil) %}
            <tr>
                <td>{{ user.new_totp_backup_codes[i * 2] or '' }}</td>
                <td>{{ user.new_totp_backup_codes[(i * 2) + 1] or '' }}</td>
            </tr>
        {% endfor %}
    </table>

    <h2>Validate Setup</h2>
    <p>Enter a code generated by your authenticator app (NOT a backup code) to confirm successful setup.</p>
    {{ wtf.quick_form(form) }}
{% endblock %}